# Production Environment Configuration
# Fix for Local Network Access warning and CORS issues

# Use 0.0.0.0 to allow access from any network interface
REACT_APP_API_URL=http://0.0.0.0:8000

# Alternative: Use your actual LAN IP if needed
# REACT_APP_API_URL=http://172.27.128.1:8000

# Enable production mode
NODE_ENV=production

# API timeout in milliseconds
REACT_APP_API_TIMEOUT=30000

# Enable debug mode (set to false in production)
REACT_APP_DEBUG=false
